pivot_longer(
cols = -c(GENDER, AGE, LUNG_CANCER),
names_to = "Variable",
values_to = "Respuesta"
)
ggplot(lung_long, aes(x = factor(Respuesta), fill = LUNG_CANCER)) +
geom_bar(position = "fill") +
facet_wrap(~Variable) +
labs(
title = "Características de los individuos según cáncer de pulmón",
x = "Respuesta (1 = No, 2 = Sí)",
y = "Proporción",
fill = "Cáncer de pulmón"
) +
theme_minimal()
###### Comparación estadística
#Edad
wilcox.test(AGE ~ LUNG_CANCER, data = lung_cancer)
#Estadísticos descriptivos
lung_cancer %>%
group_by(LUNG_CANCER) %>%
summarise(
n = n(),
media = mean(AGE),
mediana = median(AGE),
desviacion = sd(AGE)
)
#Variables Categóricas
variables <- c(
"SMOKING",
"YELLOW_FINGERS",
"ANXIETY",
"PEER_PRESSURE",
"CHRONIC DISEASE",
"FATIGUE ",
"ALLERGY ",
"WHEEZING",
"ALCOHOL CONSUMING",
"COUGHING",
"SHORTNESS OF BREATH",
"SWALLOWING DIFFICULTY",
"CHEST PAIN"
)
resultados <- data.frame(
Variable = variables,
p_value = NA
)
for (i in 1:length(variables)) {
tabla <- table(
lung_cancer[[variables[i]]],
lung_cancer$LUNG_CANCER
)
resultados$p_value[i] <- chisq.test(tabla)$p.value
}
variables <- setdiff(
names(lung_cancer),
c("GENDER", "AGE", "LUNG_CANCER")
)
resultados <- data.frame(
Variable = variables,
p_value = NA
)
for (i in 1:length(variables)) {
tabla <- table(
lung_cancer[[variables[i]]],
lung_cancer$LUNG_CANCER
)
resultados$p_value[i] <- chisq.test(tabla)$p.value
}
resultados
resultados %>%
mutate(
Significativo = ifelse(p_value < 0.05, "Sí", "No")
)
set.seed(123)
indice <- sample(
